<!-- The Paradis Capture wordmark: "PARADISE" with a red Z drawn over the final E (the E is
     crossed out, and the E/Z overlap nods to Paradis EZ Utilities), then "CAPTURE".
     Drawn with Segoe UI and vector strokes, so it needs no image or font files. Set Height to size it. -->
<UserControl x:Class="ParadisCapture.UI.Wordmark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False" Focusable="False"
             AutomationProperties.Name="Paradis Capture">
  <Viewbox Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" TextOptions.TextFormattingMode="Ideal" SnapsToDevicePixels="False">
      <TextBlock Text="PARADIS" FontFamily="Segoe UI" FontWeight="Bold" FontSize="28"
                 Foreground="{StaticResource Text}" />
      <Grid>
        <TextBlock Text="E" FontFamily="Segoe UI" FontWeight="Bold" FontSize="28"
                   Foreground="{StaticResource TextDim}" Opacity="0.85" />
        <!-- A hand-drawn red Z over the E: it reads both as the E being crossed out and as "EZ".
             The Z starts inside the E and runs past its right side; the inner Viewbox maps the
             13 × 9.7 drawing onto the E's cap height. -->
        <Viewbox Stretch="Fill" Margin="-3,8,-7,5" IsHitTestVisible="False">
          <Canvas Width="13" Height="9.7">
            <Path Stroke="{StaticResource Record}" StrokeThickness="0.9" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M4.6,2.0 C7,1.3 9.4,0.6 11.8,0 L0.6,9.4 C4.4,8.2 8.4,7.7 12.6,7.4" />
            <!-- Thin second strokes along the bars, for a quick brush feel. -->
            <Path Stroke="{StaticResource Record}" StrokeThickness="0.47" Opacity="0.85"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M3.6,2.9 C5.8,2.2 8,1.6 10,1.2 M5,9.0 C7.8,8.4 10.4,8.2 13,8.2" />
          </Canvas>
        </Viewbox>
      </Grid>
      <TextBlock Text="CAPTURE" FontFamily="Segoe UI" FontWeight="Light" FontSize="28" Margin="12,0,0,0"
                 Foreground="{StaticResource Text}" />
    </StackPanel>
  </Viewbox>
</UserControl>
