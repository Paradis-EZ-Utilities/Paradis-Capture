<Window x:Class="ParadisCapture.UI.MonitorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a monitor" SizeToContent="Height" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Background}" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="18">
    <TextBlock Text="Which monitor do you want to record?" Margin="0,0,0,12" />
    <ItemsControl x:Name="MonitorList">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource TargetButton}" Margin="0,0,0,8" Click="OnPick" Tag="{Binding}">
            <StackPanel>
              <TextBlock Text="{Binding DisplayName}" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                <Run Text="{Binding Bounds.Width, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Bounds.Height, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Style="{StaticResource FlatButton}" Content="Cancel" HorizontalAlignment="Right"
            Padding="12,6" Click="OnCancel" IsCancel="True" />
  </StackPanel>
</Window>
