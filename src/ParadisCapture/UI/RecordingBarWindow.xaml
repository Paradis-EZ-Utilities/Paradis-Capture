<Window x:Class="ParadisCapture.UI.RecordingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" ShowInTaskbar="True" Topmost="True" ResizeMode="NoResize"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Border Background="#F21E1F22" CornerRadius="10" BorderBrush="#3C4046" BorderThickness="1"
          Padding="14,10" MouseLeftButtonDown="OnDragBar" Cursor="SizeAll">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="Indicator" Width="11" Height="11" Fill="{StaticResource Record}"
                 VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="19" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,14,0"
                   FontFamily="Consolas, Cascadia Mono, Segoe UI" />
        <Button x:Name="PauseButton" Style="{StaticResource FlatButton}" Content="Pause"
                Padding="12,6" Click="OnPause" Cursor="Hand" />
        <Button x:Name="StopButton" Style="{StaticResource FlatButton}" Content="Stop"
                Padding="14,6" Margin="7,0,0,0" Click="OnStop" Cursor="Hand"
                Background="{StaticResource Record}" BorderBrush="#F05B57" FontWeight="SemiBold" />
        <Button x:Name="TrayButton" Style="{StaticResource FlatButton}" Content="—"
                Padding="10,6" Margin="7,0,0,0" Click="OnMinimizeToTray" Cursor="Hand"
                ToolTip="Hide to the system tray" />
      </StackPanel>

      <TextBlock x:Name="TargetText" Style="{StaticResource Caption}" Margin="20,7,0,0"
                 TextTrimming="CharacterEllipsis" MaxWidth="320" />
      <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" Margin="20,5,0,0"
                 TextWrapping="Wrap" MaxWidth="320" Foreground="#FFB74D" Visibility="Collapsed" />
    </StackPanel>
  </Border>
</Window>
