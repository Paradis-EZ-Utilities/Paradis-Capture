<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral recording logic (timing, audio timeline/mixing, geometry, naming).
       Kept free of Windows APIs so it can be unit-tested anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ParadisCapture.Core.Tests" />
  </ItemGroup>
</Project>
